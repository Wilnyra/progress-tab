---
import Layout from '@/layouts/Layout.astro'
import Logo from '@/components/ui/Logo.astro'
import Footer from '@/components/layout/Footer.astro'
---

<Layout
  title="Author — Progress Tab"
  description="Ilya Rogachev — the developer behind Progress Tab."
>
  <div class="min-h-screen bg-background text-foreground">

    <!-- Top nav -->
    <div class="sticky top-0 z-50 border-b border-border/50 bg-background/80 backdrop-blur-sm">
      <div class="mx-auto flex max-w-container items-center justify-between gap-4 px-5 py-4 sm:px-8 lg:px-12">
        <a
          href="/"
          class="group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-foreground"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
            class="transition-transform duration-200 group-hover:-translate-x-0.5">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back
        </a>
        <Logo />
      </div>
    </div>

    <!-- Content -->
    <main class="mx-auto max-w-[42rem] px-5 pb-24 pt-16 sm:px-8 sm:pt-20">

      <!-- Header -->
      <div class="mb-10 animate-fade-up" style="animation-delay: 0.05s">
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-time/25 bg-time/5 px-3.5 py-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-time"></span>
          <span class="text-xs font-medium tracking-wide text-time">Author</span>
        </div>
        <h1 class="font-display text-hero leading-none text-foreground">
          Ilya<br />Rogachev
        </h1>
      </div>

      <!-- Bio + LinkedIn -->
      <div class="animate-fade-up space-y-8" style="animation-delay: 0.12s">

        <div class="bio-text space-y-4">
          <p>
            Hi, I'm <strong>Ilya Rogachev</strong> — a software developer who built Progress Tab
            to solve a problem I had myself: staying consistent with things that actually matter.
          </p>
          <p>
            I believe small daily actions compound into something meaningful over time. This tool
            is my attempt to make that compounding visible.
          </p>
        </div>

        <a
          href="https://www.linkedin.com/in/ilya-rogachev/"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2.5 rounded-lg border border-border/60 bg-surface/60 px-4 py-2.5 text-sm font-medium text-foreground/80 transition-all hover:border-time/40 hover:bg-surface hover:text-foreground"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-time shrink-0">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          Connect on LinkedIn
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"
            class="opacity-40 transition-opacity group-hover:opacity-70">
            <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor"
              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <!-- Beliefs -->
        <div class="beliefs">
          <h2 class="beliefs-heading">Things I believe</h2>
          <ul class="beliefs-list">
            <li>Small daily actions compound more than most people expect.</li>
            <li>Quitting is rarely about laziness — it's about invisible progress.</li>
            <li>The best tool is the one you actually use, not the most powerful one.</li>
            <li>Time is a fairer measure of effort than output.</li>
          </ul>
        </div>

        <!-- Why link -->
        <div class="why-link-block">
          <p class="text-sm text-muted mb-4">Want to read the full story of why this project exists?</p>
          <a href="/why" class="why-link group">
            <span>Read the origin story</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
              class="transition-transform duration-200 group-hover:translate-x-0.5">
              <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .bio-text {
    color: hsl(0 0% 82%);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .bio-text strong {
    color: hsl(0 0% 98%);
    font-weight: 600;
  }

  .beliefs {
    padding: 1.75rem 2rem;
    background: hsl(240 8% 7%);
    border: 1px solid hsl(240 4% 16%);
    border-radius: 0.875rem;
  }

  .beliefs-heading {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(0 0% 50%);
    margin-bottom: 1.25rem;
  }

  .beliefs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .beliefs-list li {
    font-size: 1rem;
    color: hsl(0 0% 90%);
    line-height: 1.6;
    padding-left: 1.25rem;
    position: relative;
  }

  .beliefs-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: hsl(160 65% 55%);
  }

  .why-link-block {
    padding-top: 2rem;
    border-top: 1px solid hsl(240 4% 14%);
  }

  .why-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: hsl(160 65% 65%);
    transition: color 0.15s;
  }

  .why-link:hover {
    color: hsl(160 65% 75%);
  }
</style>
