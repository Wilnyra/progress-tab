---
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
---

<a
  href="#top"
  class={`group inline-flex items-center gap-2.5 text-foreground ${className}`}
  aria-label="The Tab Progress — home"
>
  <svg
    class="h-8 w-8 shrink-0 transition-transform duration-300 group-hover:rotate-12"
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M16 1 28.99 8.5v15L16 31 3.01 23.5V8.5z"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"
      opacity="0.4"></path>
    <path
      d="M9.13 19.44 16 12.56l6.87 6.88"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="text-lg font-semibold tracking-tight">The Tab Progress</span>
</a>
