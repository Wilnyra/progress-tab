---
import Logo from '@/components/ui/Logo.astro'
import { APP_URL } from '@/lib/config'

const CONTACT_EMAIL = 'theprogresstab@gmail.com'
const year = new Date().getFullYear()
---

<footer class="relative border-t border-border/60 bg-surface/40">
  <div class="mx-auto w-full max-w-container px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
      <!-- Brand -->
      <div class="max-w-sm">
        <Logo />
        <p class="mt-4 text-sm leading-relaxed text-muted">
          Don't track time. Track momentum. Stay consistent, build streaks, and
          finish what you start.
        </p>
      </div>

      <!-- Explore -->
      <nav aria-label="Footer">
        <h3 class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-muted">
          Explore
        </h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a
              href={APP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground/80 transition-colors hover:text-foreground"
            >
              Open the app
            </a>
          </li>
          <li>
            <a
              href="/why"
              class="text-foreground/80 transition-colors hover:text-foreground"
            >
              Why this exists
            </a>
          </li>
          <li>
            <a
              href="#showcase"
              class="text-foreground/80 transition-colors hover:text-foreground"
            >
              Inside the app
            </a>
          </li>
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h3 class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-time">
          Contact
        </h3>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          Questions, feedback, or just want to say hi? Drop us a line.
        </p>
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="group mt-4 inline-flex items-center gap-2 text-sm font-medium text-foreground transition-colors hover:text-time"
        >
          <svg
            class="h-4 w-4 text-time"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
          {CONTACT_EMAIL}
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-border/60 pt-8 text-xs text-muted sm:flex-row"
    >
      <p>&copy; {year} Progress Tab</p>
      <p class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-momentum"></span>
        Built for momentum
      </p>
    </div>
  </div>
</footer>
