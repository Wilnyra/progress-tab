---
import Button from '@/components/ui/Button.astro'
import ArrowRight from '@/components/ui/ArrowRight.astro'
import MomentumChart from '@/components/chart/MomentumChart.astro'
import { APP_URL } from '@/lib/config'
---

<section
  id="top"
  class="relative flex min-h-[100svh] flex-col overflow-hidden"
>
  <div
    class="relative z-10 mx-auto w-full max-w-container px-5 pt-28 sm:px-8 sm:pt-32 lg:px-12 lg:pt-44"
  >
    <div class="max-w-2xl lg:max-w-[58%]">
      <h1
        class="font-display text-hero font-normal text-foreground animate-fade-up"
        style="animation-delay:0.05s"
      >
        Don&rsquo;t track time.<br />Track momentum.
      </h1>

      <p
        class="text-fluid-lead mt-6 max-w-md text-muted animate-fade-up sm:mt-8"
        style="animation-delay:0.18s"
      >
        The Tab Progress helps you stay consistent, build momentum, and finish
        what you start.
      </p>

      <div
        class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4 animate-fade-up sm:mt-11"
        style="animation-delay:0.3s"
      >
        <Button href={APP_URL} size="lg">
          Start tracking
          <ArrowRight class="h-4 w-4" />
        </Button>
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none relative z-0 mt-8 min-h-[260px] flex-1 px-2 sm:mt-10 sm:px-6 lg:absolute lg:inset-0 lg:mt-0 lg:flex-none lg:px-10"
  >
    <MomentumChart />
  </div>
</section>
