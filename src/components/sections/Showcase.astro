---
import BrowserMockup from '@/components/ui/BrowserMockup.astro'
---

<section id="showcase" class="relative py-20 sm:py-28 lg:py-32">
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 lg:px-12">
    <div
      class="overflow-hidden rounded-3xl border border-border/60 bg-gradient-to-br from-time/15 via-surface to-background p-6 animate-fade-up sm:p-10 lg:p-16"
      style="animation-delay:0.05s"
    >
      <BrowserMockup />
    </div>
  </div>
</section>
